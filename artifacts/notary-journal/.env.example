# ============================================
# Notary Journal — Environment Variables
# ============================================

# Newsletter / waitlist signup (Formspree)
# Create a free form at https://formspree.io and paste the endpoint URL below.
# Free tier: 50 submissions/month. The NewsletterSignup component hides itself
# if this variable is not set — no broken UI.
#
# VITE_NEWSLETTER_FORM_ACTION=https://formspree.io/f/YOUR_FORM_ID

# Client Intake Form (Formspree)
# This powers the public client-facing intake form at /intake
#
# Step 1: Create a form at formspree.io → copy the Form Endpoint
# Step 2: In Formspree dashboard → Settings → API → generate a token
# Step 3: Paste both below
#
# VITE_INTAKE_FORM_ENDPOINT=xnqkvpzy
# VITE_INTAKE_API_TOKEN=your_api_token_here
